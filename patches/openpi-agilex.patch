+@dataclasses.dataclass(frozen=True)
+class LeRobotNeroDataConfig(DataConfigFactory):
+    """Single-arm NERO (7DoF + gripper = 8-dim) LeRobot config.
+
+    Pure-official single-arm recipe: identical in structure to the DROID 8-dim /
+    Libero templates. Joints -> delta, gripper -> absolute, via make_bool_mask(7, -1).
+    The only robot-specific piece is nero_policy.NeroInputs/NeroOutputs (which the
+    official Libero docstring explicitly tells you to copy & adapt for your robot).
+    """
+
+    use_delta_joint_actions: bool = True
+    # SERVE-ONLY: the ref model is trained in rad + gripper[0,1] (transforms baked into the
+    # b2_ref dataset). Set True only for the serve config so the server converts deg+mm <->
+    # rad+[0,1] internally and client_b (deg+mm) connects unchanged. Leave False for training
+    # configs (the dataset is already in the model's native space). Has NO effect on training.
+    serve_convert_degmm: bool = False
+    default_prompt: str | None = None
+    action_sequence_keys: Sequence[str] = ("action",)
+
+    @override
+    def create(self, assets_dirs: pathlib.Path, model_config: _model.BaseModelConfig) -> DataConfig:
+        # Remap LeRobot dataset columns (produced by the official hdf5_to_lerobot
+        # converter) to the model input keys. NERO has two cameras: cam_high + cam_wrist.
+        repack_transform = _transforms.Group(
+            inputs=[
+                _transforms.RepackTransform(
+                    {
+                        "observation/image": "observation.images.cam_high",
+                        "observation/wrist_image": "observation.images.cam_wrist",
+                        "observation/state": "observation.state",
+                        "actions": "action",
+                    }
+                )
+            ]
+        )
+
+        data_transforms = _transforms.Group(
+            inputs=[nero_policy.NeroInputs(model_type=model_config.model_type)],
+            outputs=[nero_policy.NeroOutputs()],
+        )
+        if self.use_delta_joint_actions:
+            delta_action_mask = _transforms.make_bool_mask(7, -1)
+            data_transforms = data_transforms.push(
+                inputs=[_transforms.DeltaActions(delta_action_mask)],
+                outputs=[_transforms.AbsoluteActions(delta_action_mask)],
+            )
+
+        # SERVE-ONLY deg+mm <-> rad+[0,1] conversion (ref). Appended last so DegToRad runs after
+        # NeroInputs (on the "state" key) & before Normalize, and RadToDeg runs after Unnormalize
+        # & NeroOutputs (on the final "actions"). Keeps the server's external contract = deg+mm.
+        if self.serve_convert_degmm:
+            data_transforms = data_transforms.push(
+                inputs=[nero_policy.NeroRefDegToRad()],
+                outputs=[nero_policy.NeroRefRadToDeg()],
+            )
+
+        model_transforms = ModelTransformFactory(default_prompt=self.default_prompt)(model_config)
+
+        return dataclasses.replace(
+            self.create_base_config(assets_dirs, model_config),
+            repack_transforms=repack_transform,
+            data_transforms=data_transforms,
+            model_transforms=model_transforms,
+            action_sequence_keys=self.action_sequence_keys,
+        )
+
