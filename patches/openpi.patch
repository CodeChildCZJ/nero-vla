 # Use `get_config` if you need to get a config by name in your code.
+
+
+# ============================================================
+# NERO single-arm config (7 joint deg + 1 gripper mm, 8-dim active out of 16 stored)
+# Mirrors LeRobotLiberoDataConfig. Inputs/Outputs inlined to avoid extra files.
+# Added 2026-06-06 for pick_pink_sponge_v1 fine-tune from pi05_base.
+# ============================================================
+
+import einops as _einops  # noqa: E402
+import numpy as np  # noqa: E402
+
+
+NERO_ACTION_DIM = 8
+
+
+def _nero_parse_image(image):
+    image = np.asarray(image)
+    if np.issubdtype(image.dtype, np.floating):
+        image = (255 * image).astype(np.uint8)
+    if image.shape[0] == 3:
+        image = _einops.rearrange(image, "c h w -> h w c")
+    return image
+
+
+@dataclasses.dataclass(frozen=True)
+class _NeroInputs(_transforms.DataTransformFn):
+    model_type: _model.ModelType
+    mask_gripper_state: bool = False  # True=输入state夹爪维(dim7)置常数, 破 causal confusion (chunk[0]复读state.grip)
+
+    def __call__(self, data: dict) -> dict:
+        base_image = _nero_parse_image(data["observation/image"])
+        wrist_image = _nero_parse_image(data["observation/wrist_image"])
+        state_16 = np.asarray(data["observation/state"], dtype=np.float32)
+        state_8 = np.array(state_16[:NERO_ACTION_DIM])
+        if self.mask_gripper_state:
+            state_8[NERO_ACTION_DIM - 1] = 0.0  # 夹爪维置常数: 训推同走此路, 逼模型从视觉(腕cam)决定夹爪而非复读
+
+        inputs = {
+            "state": state_8,
+            "image": {
+                "base_0_rgb": base_image,
+                "left_wrist_0_rgb": wrist_image,
+                "right_wrist_0_rgb": np.zeros_like(base_image),
+            },
+            "image_mask": {
+                "base_0_rgb": np.True_,
+                "left_wrist_0_rgb": np.True_,
+                "right_wrist_0_rgb": np.True_ if self.model_type == _model.ModelType.PI0_FAST else np.False_,
+            },
+        }
+        if "actions" in data:
+            act_16 = np.asarray(data["actions"], dtype=np.float32)
+            inputs["actions"] = act_16[..., :NERO_ACTION_DIM]
+        if "prompt" in data:
+            inputs["prompt"] = data["prompt"]
+        return inputs
+
+
+@dataclasses.dataclass(frozen=True)
+class _NeroOutputs(_transforms.DataTransformFn):
+    def __call__(self, data: dict) -> dict:
+        return {"actions": np.asarray(data["actions"][:, :NERO_ACTION_DIM])}
+
+
+@dataclasses.dataclass(frozen=True)
+class NeroDataConfig(DataConfigFactory):
+    use_delta_joint_actions: bool = True
+    default_prompt: str | None = None
+    mask_gripper_state: bool = False  # True=输入state夹爪维置常数, 治 gripper causal confusion
+
+    # NERO LeRobot v2.1 stores the action column as singular "action" (not "actions").
+    action_sequence_keys: Sequence[str] = ("action",)
+
+    repack_transforms: tyro.conf.Suppress[_transforms.Group] = dataclasses.field(
+        default=_transforms.Group(
+            inputs=[
+                _transforms.RepackTransform({
+                    "observation/image": "observation.images.cam_high",
+                    "observation/wrist_image": "observation.images.cam_wrist",
+                    "observation/state": "observation.state",
+                    "actions": "action",
+                })
+            ]
+        )
+    )
+
+    @override
+    def create(self, assets_dirs, model_config: _model.BaseModelConfig) -> DataConfig:
+        data_transforms = _transforms.Group(
+            inputs=[_NeroInputs(model_type=model_config.model_type, mask_gripper_state=self.mask_gripper_state)],
+            outputs=[_NeroOutputs()],
+        )
+        if self.use_delta_joint_actions:
+            delta_action_mask = _transforms.make_bool_mask(7, -1)
+            data_transforms = data_transforms.push(
+                inputs=[_transforms.DeltaActions(delta_action_mask)],
+                outputs=[_transforms.AbsoluteActions(delta_action_mask)],
+            )
+        model_transforms = ModelTransformFactory(default_prompt=self.default_prompt)(model_config)
+        return dataclasses.replace(
+            self.create_base_config(assets_dirs, model_config),
+            repack_transforms=self.repack_transforms,
+            data_transforms=data_transforms,
+            model_transforms=model_transforms,
+            action_sequence_keys=self.action_sequence_keys,
+        )
+
+
